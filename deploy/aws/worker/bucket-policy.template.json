{
  "$comment": "B14-A contract: statements the platform bucket adds for the worker protocol (beside B15's own). TLS only; attempt roles only through the VPC's gateway endpoint; every object creation (PutObject, CompleteMultipartUpload) of a staging, ticket, claim or result key carries If-None-Match (no overwrite, ever) while the multipart steps that cannot carry it (CreateMultipartUpload, UploadPart) stay allowed, per AWS: conditional-writes-enforce; attempt roles never delete.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TlsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::${OBJECT_BUCKET}", "arn:aws:s3:::${OBJECT_BUCKET}/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "AttemptsOnlyThroughTheEndpoint",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::${OBJECT_BUCKET}/*",
      "Condition": { "ArnLike": { "aws:PrincipalArn": "arn:aws:iam::${ACCOUNT_ID}:role/kauro-attempts/*" }, "StringNotEquals": { "aws:SourceVpce": "${S3_GATEWAY_ENDPOINT_ID}" } }
    },
    {
      "Sid": "CreateOnce",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": ["arn:aws:s3:::${OBJECT_BUCKET}/staging/*", "arn:aws:s3:::${OBJECT_BUCKET}/tickets/*", "arn:aws:s3:::${OBJECT_BUCKET}/claims/*", "arn:aws:s3:::${OBJECT_BUCKET}/results/*"],
      "Condition": { "Null": { "s3:if-none-match": "true" }, "Bool": { "s3:ObjectCreationOperation": "true" } }
    },
    {
      "Sid": "AttemptsNeverDelete",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::${OBJECT_BUCKET}/*",
      "Condition": { "ArnLike": { "aws:PrincipalArn": "arn:aws:iam::${ACCOUNT_ID}:role/kauro-attempts/*" } }
    }
  ]
}
