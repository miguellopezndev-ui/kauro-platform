{
  "$comment": "Order 25 (D-19: CloudTrail data events; D-21; policy.json securityLogsDays): the audit bucket in the data account. The organization trail is created by the data account as CloudTrail's delegated administrator but OWNED by the management account (CloudTrail user guide, delegated administrator), so its ARN and its log prefix name the management account. It writes the management events of every account and the data events of the protected buckets here, and nothing else writes. Nobody deletes a log: the lifecycle expires it when its governance retention ends; the guards change only in the owner's administrator session.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudTrailAclCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::${AUDIT_BUCKET}",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "${TRAIL_ARN}"
        }
      }
    },
    {
      "Sid": "CloudTrailWritesTheOrganizationTrail",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::${AUDIT_BUCKET}/AWSLogs/${MANAGEMENT_ACCOUNT_ID}/*",
        "arn:aws:s3:::${AUDIT_BUCKET}/AWSLogs/${ORG_ID}/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "${TRAIL_ARN}"
        }
      }
    },
    {
      "Sid": "NobodyDeletesALog",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:BypassGovernanceRetention",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectLegalHold",
        "s3:PutObjectRetention"
      ],
      "Resource": "arn:aws:s3:::${AUDIT_BUCKET}/*"
    },
    {
      "Sid": "BucketGuardsChangeOnlyInTheOwnerSession",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketAcl",
        "s3:PutBucketCORS",
        "s3:PutBucketLogging",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutReplicationConfiguration"
      ],
      "Resource": "arn:aws:s3:::${AUDIT_BUCKET}",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "${OWNER_ADMIN_ROLE_PATTERN}"
        }
      }
    },
    {
      "Sid": "TlsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::${AUDIT_BUCKET}",
        "arn:aws:s3:::${AUDIT_BUCKET}/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
