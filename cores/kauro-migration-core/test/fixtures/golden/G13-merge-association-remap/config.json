{
  "configVersion": "3.0.0",
  "source": {
    "system": "generic_csv",
    "namespace": "g13-remap"
  },
  "target": {
    "mode": "CLEAN_ONLY",
    "importMode": "CREATE_ONLY"
  },
  "files": [
    {
      "id": "contacts",
      "path": "contacts.csv",
      "format": "CSV"
    },
    {
      "id": "companies",
      "path": "companies.csv",
      "format": "CSV"
    }
  ],
  "records": [
    {
      "id": "contacts",
      "fileId": "contacts",
      "object": "CONTACT",
      "sourceRecordIdColumn": {
        "header": "Contact ID"
      },
      "fields": [
        {
          "column": {
            "header": "First Name"
          },
          "destinationField": "contact.firstName",
          "semanticType": "TEXT"
        },
        {
          "column": {
            "header": "Last Name"
          },
          "destinationField": "contact.lastName",
          "semanticType": "TEXT"
        },
        {
          "column": {
            "header": "Email"
          },
          "destinationField": "contact.email",
          "semanticType": "EMAIL"
        }
      ]
    },
    {
      "id": "companies",
      "fileId": "companies",
      "object": "COMPANY",
      "sourceRecordIdColumn": {
        "header": "Company ID"
      },
      "fields": [
        {
          "column": {
            "header": "Name"
          },
          "destinationField": "company.name",
          "semanticType": "TEXT"
        }
      ]
    }
  ],
  "associations": [
    {
      "id": "contact-company",
      "kind": "COLUMN_REFERENCE",
      "recordMappingId": "contacts",
      "relationshipType": "CONTACT_TO_COMPANY",
      "keyColumn": {
        "header": "Company ID"
      },
      "targetRecordMappingId": "companies",
      "targetMatchKey": "SOURCE_RECORD_ID"
    }
  ]
}
