{
  "configVersion": "3.0.0",
  "source": {
    "system": "generic_csv",
    "namespace": "g02-formatting"
  },
  "target": {
    "mode": "CLEAN_ONLY",
    "importMode": "CREATE_ONLY"
  },
  "files": [
    {
      "id": "contacts",
      "path": "contacts.csv",
      "format": "CSV"
    }
  ],
  "records": [
    {
      "id": "contacts",
      "fileId": "contacts",
      "object": "CONTACT",
      "sourceRecordIdColumn": {
        "header": "Contact ID"
      },
      "fields": [
        {
          "column": {
            "header": "First Name"
          },
          "destinationField": "contact.firstName",
          "semanticType": "TEXT",
          "options": {
            "trim": true
          }
        },
        {
          "column": {
            "header": "Last Name"
          },
          "destinationField": "contact.lastName",
          "semanticType": "TEXT",
          "options": {
            "trim": true
          }
        },
        {
          "column": {
            "header": "Email"
          },
          "destinationField": "contact.email",
          "semanticType": "EMAIL"
        },
        {
          "column": {
            "header": "Phone"
          },
          "destinationField": "contact.phone",
          "semanticType": "PHONE",
          "options": {
            "phoneCountry": "US",
            "extensionDestinationField": "contact.phoneExtension"
          }
        },
        {
          "column": {
            "header": "Signed Up"
          },
          "destinationField": "contact.createdAt",
          "semanticType": "DATE",
          "options": {
            "dateFormat": "MM/DD/YYYY"
          }
        }
      ]
    }
  ]
}
