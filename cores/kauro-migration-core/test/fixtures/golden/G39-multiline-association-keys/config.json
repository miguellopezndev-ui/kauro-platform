        "header": "Contact ID"
      },
      "fields": [
        {
          "column": {
            "header": "First Name"
          },
          "destinationField": "contact.firstName",
          "semanticType": "TEXT"
        },
        {
          "column": {
            "header": "Last Name"
          },
          "destinationField": "contact.lastName",
          "semanticType": "TEXT"
        },
        {
          "column": {
            "header": "Email"
          },
          "destinationField": "contact.email",
          "semanticType": "EMAIL"
        }
      ]
    },
    {
      "id": "companies",
      "fileId": "companies",
      "object": "COMPANY",
      "sourceRecordIdColumn": {
        "header": "Company ID"
      },
      "fields": [
        {
          "column": {
            "header": "Name"
          },
          "destinationField": "company.name",
          "semanticType": "TEXT"
        },
        {
          "column": {
            "header": "Domain"
          },
          "destinationField": "company.domain",
          "semanticType": "TEXT"
        }
      ]
    },
    {
      "id": "deals",
      "fileId": "deals",
      "object": "DEAL",
      "sourceRecordIdColumn": {
        "header": "Deal ID"
