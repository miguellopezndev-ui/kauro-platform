        {
          "column": {
            "header": "Deal Name"
          },
          "destinationField": "deal.name",
          "semanticType": "TEXT"
        },
        {
          "column": {
            "header": "Amount"
          },
          "destinationField": "deal.amount",
          "semanticType": "NUMBER",
          "options": {
            "decimalSeparator": ".",
            "thousandsSeparator": "NONE"
          }
        }
      ]
    }
  ],
  "associations": [
    {
      "id": "contact-company",
      "kind": "COLUMN_REFERENCE",
      "recordMappingId": "contacts",
      "relationshipType": "CONTACT_TO_COMPANY",
