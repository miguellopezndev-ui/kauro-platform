        "header": "Company ID"
      },
      "targetRecordMappingId": "companies",
      "targetMatchKey": "SOURCE_RECORD_ID"
    },
    {
      "id": "company-deal",
      "kind": "COLUMN_REFERENCE",
      "recordMappingId": "deals",
      "relationshipType": "COMPANY_TO_DEAL",
      "ownerSide": "TO",
      "keyColumn": {
        "header": "Company Name"
      },
      "targetRecordMappingId": "companies",
      "targetMatchKey": "COLUMN",
      "targetMatchColumn": {
        "header": "Name"
      }
    },
    {
      "id": "contact-deal",
      "kind": "EDGE_FILE",
      "fileId": "contactdeals",
      "relationshipType": "CONTACT_TO_DEAL",
      "fromRecordMappingId": "contacts",
      "fromKeyColumn": {
        "header": "Contact ID"
      },
      "toRecordMappingId": "deals",
      "toKeyColumn": {
        "header": "Deal ID"
      },
      "labelColumn": {
        "header": "Label"
      }
    }
