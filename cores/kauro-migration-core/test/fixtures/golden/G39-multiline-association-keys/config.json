{
  "configVersion": "3.0.0",
  "source": {
    "system": "generic_csv",
    "namespace": "g39-multiline-association-keys"
  },
  "target": {
    "mode": "CLEAN_ONLY",
    "importMode": "CREATE_ONLY"
  },
  "files": [
