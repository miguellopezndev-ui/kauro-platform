    "agencies/agencies_member_read": {
      "command": "SELECT",
      "roles": [
        "kauro_app"
      ],
      "using": "(EXISTS ( SELECT 1\n   FROM kauro.memberships m\n  WHERE ((m.agency_id = agencies.agency_id) AND (m.user_id = kauro.current_user_id()) AND (m.state = ANY (ARRAY['ACTIVE'::text, 'SUSPENDED'::text])))))",
