      "command": "UPDATE",
      "roles": [
        "kauro_app"
      ],
      "using": "(agency_id = kauro.current_agency_id())",
      "check": "((agency_id = kauro.current_agency_id()) AND ((withdrawn_by_membership_id IS NULL) OR (EXISTS ( SELECT 1\n   FROM kauro.memberships m\n  WHERE ((m.agency_id = approvals.agency_id) AND (m.membership_id = approvals.withdrawn_by_membership_id) AND (m.user_id = kauro.current_user_id()) AND (m.state = 'ACTIVE'::text) AND ((m.role = 'OWNER'::text) OR (m.membership_id = approvals.actor_membership_id)))))))"
