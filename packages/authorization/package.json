{
  "name": "@kauro/authorization",
  "version": "0.1.0",
  "description": "Kauro authorization: the Authorizer (identity status, live membership, agency scope, role, step-up assurance; default deny with safe reason and policy version), the step-up assurance verifier and the admission limiter, implementing the @kauro/application ports over @kauro/domain.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@kauro/application": "workspace:*",
    "@kauro/contracts": "workspace:*",
    "@kauro/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "typescript": "5.9.2"
  }
}
