{
  "name": "@kauro/web",
  "version": "0.1.0",
  "description": "Kauro public and agency web application (Next.js App Router, B11): renders the public pages and the agency application shells; every private fact is read by the browser from the same origin's /api/v1 under the session cookie, and every effect is an api command (docs/design/B11-agency-app.md).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json && node scripts/next.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "start": "node scripts/next.mjs start",
    "e2e": "playwright test",
    "e2e:private": "playwright test -c e2e/private.config.ts"
  },
  "dependencies": {
    "@kauro/ui": "workspace:*",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@kauro/contracts": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.2"
  }
}
