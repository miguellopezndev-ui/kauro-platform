{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "rewriteRelativeImportExtensions": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "src/copy/**/*.ts",
    "src/legal/**/*.ts",
    "src/legal/**/*.json",
    "src/public/**/*.ts",
    "src/public/**/*.tsx",
    "src/server/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
