{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/api/**/*.ts",
    "src/client/**/*.ts",
    "src/copy/**/*.ts",
    "src/server/**/*.ts",
    "src/screens.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
