{
  "name": "@kauro/api",
  "version": "0.1.0",
  "description": "Kauro HTTP API (Fastify): the seven B06 command routes with the manual-10 admission pipeline (content type, size, strict JSON, closed schema, envelope headers, authenticated subject), typed replies and safe problem responses.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@kauro/application": "workspace:*",
    "@kauro/authorization": "workspace:*",
    "@kauro/contracts": "workspace:*",
    "@kauro/domain": "workspace:*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "typescript": "5.9.2"
  }
}
